{
  "name": "openflowkit-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "generate:dsl": "node scripts/generate-dsl-reference.mjs",
    "generate:examples": "tsx scripts/build-examples.mts",
    "generate:refs": "tsx scripts/generate-references.mts",
    "check:docs": "node scripts/check-docs.mjs",
    "predev": "npm run generate:dsl && npm run generate:examples && npm run generate:refs && npm run check:docs",
    "prebuild": "npm run generate:dsl && npm run generate:examples && npm run generate:refs && npm run check:docs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/starlight": "^0.42.5",
    "astro": "^7.3.5",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "zod": "3"
  }
}
