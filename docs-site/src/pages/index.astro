---
// The landing page: one screen of the real app (captured by
// scripts/capture-screens.mjs), three ways in, and where to read next. It uses
// the docs' app tokens (custom.css), so it looks like the product it describes.
import '../styles/custom.css';

const paths = [
  {
    label: 'Draw',
    href: '/canvas-basics/',
    copy: 'An infinite canvas with shapes, connectors, ink, images and charts — the shortcuts a drawing tool should have.',
  },
  {
    label: 'Write',
    href: '/openflow-dsl/',
    copy: 'Nine diagram families in one forgiving text language. Generate a frame from the code panel; edit the code to change it.',
  },
  {
    label: 'Delegate',
    href: '/mcp-server/',
    copy: 'An MCP server gives your agent the same operations you have, on the live canvas or on files. BYOK generation works too.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OpenFlowKit — diagrams as text, canvas as truth</title>
    <meta
      name="description"
      content="OpenFlowKit is a local-first, agent-native canvas where technical diagrams live as text first and as pictures always. OpenFlow DSL, nine families, MCP."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://docs.openflowkit.com/" />
    <link rel="preload" href="/fonts/inter-400-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Outside Starlight there is no theme toggle: follow the OS, and honour a
      // choice made in the docs (Starlight stores it under this key).
      const stored = (() => { try { return localStorage.getItem('starlight-theme'); } catch { return null; } })();
      document.documentElement.dataset.theme = stored === 'light' || stored === 'dark' ? stored
        : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    </script>
    <style>
      body {
        margin: 0;
        color: var(--sl-color-text);
        font: 400 1rem/1.6 var(--sl-font);
        background-color: var(--ofk-canvas);
        background-image: radial-gradient(circle, var(--ofk-dot) 1px, transparent 1.2px);
        background-size: 20px 20px;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .wrap {
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 1rem;
      }
      /* The nav is a floating bar, like the app's title bar. */
      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin: 1rem auto 0;
        padding: 0.5rem 0.5rem 0.5rem 1rem;
        border: 1px solid var(--ofk-border);
        border-radius: 12px;
        background: var(--ofk-surface);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 600;
        color: var(--ofk-text);
      }
      .brand img {
        width: 24px;
        height: 24px;
      }
      .nav nav {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.875rem;
        font-weight: 500;
      }
      .nav nav a:not(.button) {
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
      }
      .nav nav a:not(.button):hover {
        background: var(--ofk-raised);
        color: var(--ofk-text);
      }
      .button {
        display: inline-flex;
        align-items: center;
        min-height: 40px;
        padding: 0 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        white-space: nowrap;
        transition: background-color 150ms cubic-bezier(0.2, 0, 0, 1);
      }
      .button-primary {
        background: var(--ofk-primary);
        color: var(--ofk-on-primary);
      }
      .button-primary:hover {
        background: var(--ofk-primary-hover);
      }
      .button-quiet {
        border: 1px solid var(--ofk-border);
        background: var(--ofk-surface);
        color: var(--ofk-text);
      }
      .button-quiet:hover {
        background: var(--ofk-raised);
      }
      .hero {
        max-width: 44rem;
        margin: 4.5rem auto 2.5rem;
        text-align: center;
      }
      .hero h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 600;
        line-height: 1.1;
        letter-spacing: -0.025em;
        color: var(--ofk-text);
      }
      .hero p {
        margin: 1rem auto 0;
        max-width: 38rem;
        font-size: 1.0625rem;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1.75rem;
      }
      .screen {
        margin: 0;
      }
      section {
        margin-top: 3.5rem;
      }
      h2 {
        margin: 0 0 1rem;
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--ofk-text);
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem;
      }
      .card {
        display: block;
        padding: 1.25rem;
        border: 1px solid var(--ofk-border);
        border-radius: 12px;
        background: var(--ofk-surface);
        transition: border-color 150ms cubic-bezier(0.2, 0, 0, 1);
      }
      .card:hover {
        border-color: var(--sl-color-gray-3);
      }
      .card strong {
        display: block;
        margin-bottom: 0.35rem;
        color: var(--ofk-text);
        font-weight: 600;
      }
      .card p {
        margin: 0;
        font-size: 0.9375rem;
      }
      .card-link {
        font-weight: 500;
        color: var(--ofk-text);
      }
      footer {
        margin: 4rem 0 2rem;
        font-size: 0.8125rem;
        color: var(--ofk-muted);
        text-align: center;
      }
      @media (max-width: 50em) {
        .grid {
          grid-template-columns: 1fr;
        }
        .nav nav a:not(.button):not(.keep) {
          display: none;
        }
        .hero {
          margin-top: 3rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="nav">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" />
          OpenFlowKit
        </a>
        <nav aria-label="Main">
          <a class="keep" href="/introduction/">Docs</a>
          <a href="/openflow-dsl-reference/">DSL reference</a>
          <a href="https://github.com/Vrun-design/openflowkit">GitHub</a>
          <a class="button button-primary" href="https://app.openflowkit.com">Open the app</a>
        </nav>
      </header>
      <main>
        <div class="hero">
          <h1>Diagrams that start as text and end as pictures.</h1>
          <p>
            OpenFlowKit is a local-first, agent-native canvas. Write OpenFlow DSL, draw on the
            canvas, or hand either to an agent — one compiler turns all three into the same
            document, and nothing leaves your machine.
          </p>
          <div class="actions">
            <a class="button button-primary" href="/quick-start/">Start in five minutes</a>
            <a class="button button-quiet" href="/openflow-dsl/">Read the DSL</a>
          </div>
        </div>
        <figure class="ofk-screen screen">
          <img class="ofk-screen-light" src="/screens/editor-light.webp" width="2880" height="1800" loading="lazy"
            alt="The OpenFlowKit editor: an architecture diagram on the canvas, generated from the OpenFlow DSL in the code panel beside it" />
          <img class="ofk-screen-dark" src="/screens/editor-dark.webp" width="2880" height="1800" loading="lazy"
            alt="The OpenFlowKit editor in dark mode: an architecture diagram generated from the OpenFlow DSL in the code panel" />
        </figure>

        <section>
          <h2>Three ways in</h2>
          <div class="grid">
            {paths.map((path) => (
              <a class="card" href={path.href}>
                <strong>{path.label}</strong>
                <p>{path.copy}</p>
              </a>
            ))}
          </div>
        </section>

        <section>
          <h2>Keep reading</h2>
          <div class="grid">
            <a class="card card-link" href="/keyboard-shortcuts/">Every shortcut, generated from the app</a>
            <a class="card card-link" href="/animated-export/">Animated SVG, GIF, MP4 and WebM</a>
            <a class="card card-link" href="/architecture-c4/">The C4 model layer</a>
          </div>
        </section>
      </main>
      <footer>OpenFlowKit is open source and local-first.</footer>
    </div>
  </body>
</html>
