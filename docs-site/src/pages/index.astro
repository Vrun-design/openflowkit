---
// The landing page: one screen, one compiled example, three ways in. The
// example SVG is read from the manifest the docs build generates, so the hero
// is the same compiler output the reference pages show.
import { readFileSync } from 'node:fs';
import '../styles/custom.css';

interface ExampleView {
  readonly name: string;
  readonly light: string;
  readonly dark: string;
  readonly width: number;
  readonly height: number;
}
interface ExampleEntry {
  readonly family: string;
  readonly views: readonly ExampleView[];
}

const manifest = JSON.parse(
  readFileSync(new URL('../../public/examples/examples.json', import.meta.url), 'utf8'),
) as Record<string, ExampleEntry>;
const hero = Object.values(manifest).find((entry) => entry.family === 'architecture' && entry.views.length === 1);
const heroView = hero?.views[0];

const paths = [
  {
    label: 'Draw',
    href: '/canvas-basics/',
    copy: 'An infinite canvas with shapes, connectors, ink, images and charts — the shortcuts a drawing tool should have.',
  },
  {
    label: 'Write',
    href: '/openflow-dsl/',
    copy: 'Nine diagram families in one forgiving text language. Generate a frame from the code panel; edit the code to change it.',
  },
  {
    label: 'Delegate',
    href: '/mcp-server/',
    copy: 'An MCP server gives your agent the same operations you have, on the live canvas or on files. BYOK generation works too.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OpenFlowKit — diagrams as text, canvas as truth</title>
    <meta
      name="description"
      content="OpenFlowKit is a local-first, agent-native canvas where technical diagrams live as text first and as pictures always. OpenFlow DSL, nine families, MCP."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://docs.openflowkit.com/" />
    <script is:inline>
      // Outside Starlight there is no theme toggle; follow the OS and reuse the
      // docs dark tokens by setting the same data-theme attribute Starlight uses.
      document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    </script>
    <style>
      body {
        margin: 0;
        background: var(--docs-surface);
        color: var(--docs-text);
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      }
      a {
        color: inherit;
      }
      .ofk-landing-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        max-width: 72rem;
        margin: 0 auto;
        padding: 1.25rem 1.5rem;
      }
      .ofk-landing-nav nav {
        display: flex;
        gap: 1.1rem;
        font-size: 0.92rem;
        font-weight: 600;
      }
      .ofk-landing-nav a {
        text-decoration: none;
      }
      .ofk-landing-brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--docs-text-strong);
      }
      .ofk-landing-brand img {
        width: 26px;
        height: 26px;
      }
      main {
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 1.5rem 4rem;
      }
      .ofk-landing-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 1.25rem;
        align-items: stretch;
        margin-top: 1rem;
      }
      .ofk-landing-copy,
      .ofk-landing-hero figure,
      .ofk-landing-path,
      .ofk-landing-next a {
        border: 1px solid var(--docs-border);
        border-radius: 1.6rem;
        background: var(--docs-surface);
        box-shadow: var(--docs-panel-shadow);
      }
      .ofk-landing-copy {
        padding: clamp(1.6rem, 4vw, 2.6rem);
      }
      .ofk-landing-copy h1 {
        margin: 0.4rem 0 0;
        font-size: clamp(2.1rem, 4.4vw, 3.4rem);
        line-height: 1.02;
        letter-spacing: -0.04em;
        color: var(--docs-text-strong);
      }
      .ofk-landing-copy p {
        max-width: 42rem;
        line-height: 1.7;
      }
      .ofk-landing-eyebrow {
        margin: 0;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--sl-color-accent);
      }
      .ofk-landing-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        margin-top: 1.6rem;
      }
      .ofk-landing-actions a {
        display: inline-flex;
        align-items: center;
        min-height: 3rem;
        padding: 0.8rem 1.25rem;
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
      }
      .ofk-landing-primary {
        background: var(--docs-cta-bg);
        color: var(--docs-cta-text);
      }
      .ofk-landing-secondary {
        border: 1px solid var(--docs-border-strong);
        color: var(--docs-text-strong);
        background: var(--docs-surface-soft);
      }
      .ofk-landing-hero figure {
        display: grid;
        place-items: center;
        gap: 0.5rem;
        margin: 0;
        padding: 1.25rem;
      }
      .ofk-landing-hero img {
        max-width: 100%;
        height: auto;
      }
      .ofk-landing-hero figcaption {
        font-size: 0.78rem;
        color: var(--docs-text-soft);
      }
      .ofk-landing-dark {
        display: none;
      }
      .ofk-landing-section {
        margin-top: 2.5rem;
      }
      .ofk-landing-section h2 {
        margin: 0 0 1rem;
        font-size: clamp(1.4rem, 2.6vw, 1.9rem);
        letter-spacing: -0.03em;
        color: var(--docs-text-strong);
      }
      .ofk-landing-paths {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }
      .ofk-landing-path {
        display: block;
        padding: 1.3rem;
        text-decoration: none;
      }
      .ofk-landing-path strong {
        display: block;
        margin-bottom: 0.4rem;
        font-size: 1.05rem;
        color: var(--docs-text-strong);
      }
      .ofk-landing-path p {
        margin: 0;
        line-height: 1.65;
      }
      .ofk-landing-next {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem;
      }
      .ofk-landing-next a {
        padding: 1rem 1.05rem;
        text-decoration: none;
        font-weight: 600;
        color: var(--docs-text-strong);
      }
      :root[data-theme='dark'] .ofk-landing-light {
        display: none;
      }
      :root[data-theme='dark'] .ofk-landing-dark {
        display: block;
      }
      @media (max-width: 60em) {
        .ofk-landing-hero,
        .ofk-landing-paths,
        .ofk-landing-next {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <header class="ofk-landing-nav">
      <span class="ofk-landing-brand">
        <img src="/favicon.svg" alt="" />
        OpenFlowKit
      </span>
      <nav aria-label="Main">
        <a href="/introduction/">Docs</a>
        <a href="/quick-start/">Quick start</a>
        <a href="https://app.openflowkit.com">Open the app</a>
      </nav>
    </header>
    <main>
      <section class="ofk-landing-hero">
        <div class="ofk-landing-copy">
          <p class="ofk-landing-eyebrow">OpenFlowKit 2.0</p>
          <h1>Diagrams that start as text and end as pictures.</h1>
          <p>
            OpenFlowKit is a local-first, agent-native canvas. Write OpenFlow DSL, draw on the
            canvas, or hand either to an agent — one compiler turns all three into the same
            document, and nothing leaves your machine.
          </p>
          <div class="ofk-landing-actions">
            <a class="ofk-landing-primary" href="/quick-start/">Start in five minutes</a>
            <a class="ofk-landing-secondary" href="/openflow-dsl/">Read the DSL</a>
          </div>
        </div>
        {heroView ? (
          <figure>
            <img
              class="ofk-landing-light"
              src={`/examples/${heroView.light}`}
              alt="An architecture diagram compiled by OpenFlowKit from OpenFlow DSL"
              width={heroView.width}
              height={heroView.height}
            />
            <img
              class="ofk-landing-dark"
              src={`/examples/${heroView.dark}`}
              alt="An architecture diagram compiled by OpenFlowKit from OpenFlow DSL"
              width={heroView.width}
              height={heroView.height}
            />
            <figcaption>Compiled from the DSL at build time — the same output the reference shows.</figcaption>
          </figure>
        ) : null}
      </section>

      <section class="ofk-landing-section">
        <h2>Three ways in</h2>
        <div class="ofk-landing-paths">
          {paths.map((path) => (
            <a class="ofk-landing-path" href={path.href}>
              <strong>{path.label}</strong>
              <p>{path.copy}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="ofk-landing-section">
        <h2>Keep reading</h2>
        <div class="ofk-landing-next">
          <a href="/keyboard-shortcuts/">Every shortcut, generated from the app</a>
          <a href="/animated-export/">Animated SVG, GIF, MP4 and WebM</a>
          <a href="/architecture-c4/">The C4 model layer</a>
        </div>
      </section>
    </main>
  </body>
</html>
