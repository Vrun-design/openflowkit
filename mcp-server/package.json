{
  "name": "@vrun-design/openflowkit-mcp",
  "version": "0.1.2",
  "mcpName": "io.github.Vrun-design/openflowkit-mcp",
  "description": "Local-first Model Context Protocol server for OpenFlowKit \u2014 deterministic diagramming tools (validate DSL, templates, icons, viewer links) for Claude Desktop, Cursor, Windsurf, and other MCP clients. No API key, no cloud round-trip.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openflowkit",
    "diagram",
    "flowchart",
    "mermaid",
    "claude",
    "cursor",
    "windsurf",
    "local-first"
  ],
  "homepage": "https://github.com/Vrun-design/openflowkit#readme",
  "bugs": "https://github.com/Vrun-design/openflowkit/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vrun-design/openflowkit.git",
    "directory": "mcp-server"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "openflowkit-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:icons": "node scripts/build-icon-manifest.mjs",
    "prebuild": "npm run build:icons && npm run build:agent",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest --config vitest.config.ts --run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "build:agent": "npm --prefix .. run build:agent",
    "pretest": "npm run build:agent",
    "pretest:run": "npm run build:agent",
    "prelint": "npm run build:agent"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pako": "^2.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pako": "^2.0.4",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
